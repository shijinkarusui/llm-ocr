# Copy to .env and fill in your own key. .env is git-ignored.
# This file documents the customizable URL contract for the delivery.

# Octopus gateway base URL (customizable). Must be the /v1 root, not /v1/chat/completions.
# Example: http://127.0.0.1:2113/v1
# Any OpenAI-compatible base_url works here (OpenAI, Octopus, AxonHub, etc.)
LLM_OCR_BASE_URL=http://127.0.0.1:2113/v1

# Model id is the Octopus group name (must keep OC/ prefix for Octopus)
LLM_OCR_MODEL=OC/muse-spark-1.3-contributor-free

# API key - set exactly one of these (first match wins: LLM_OCR_KEY > LLM_OCR_API_KEY > OCTOPUS_API_KEY)
LLM_OCR_KEY=sk-octopus-...

# Endpoint: responses | chat | auto (+experimental messages; Octopus exposes all on /v1/*)
# responses  -> POST /v1/responses         (OpenAI Responses; CLI default)
# chat       -> POST /v1/chat/completions  (OpenAI Chat Completions; lib default)
# auto       -> auto_vision() 1+1 (responses single-try, fallback chat on 429/5xx/timeout/OSError only)
# messages   -> POST /v1/messages          (Anthropic Messages, experimental, no guarantee)
# CLI default responses / lib default chat. Override via --endpoint or LLM_OCR_ENDPOINT.
LLM_OCR_ENDPOINT=responses

# Concurrency 1..20 (CLI default 4 / lib default 1; >8 warns, >20 rejects) + adaptive halving/recovery
LLM_OCR_CONCURRENCY=4

# Image detail high|low|auto (default high, recommended for IPA)
LLM_OCR_DETAIL=high

# POST timeout seconds (POST-only; GET /v1/models is fixed 15s single-try)
LLM_OCR_TIMEOUT=120

# Flexible params (full passthrough — any official field goes here):
# All other params merge straight into the JSON body via --extra-json.
# Examples:
#   --extra-json '{"temperature":0.2,"max_completion_tokens":8192}'
#   --extra-json '{"reasoning_effort":"low","verbosity":"low"}'
#   --extra-json '{"reasoning":{"effort":"low"},"text":{"verbosity":"low"}}'  (responses)
#   --extra-json '{"thinking":{"type":"enabled","budget_tokens":4096}}'       (anthropic)
# Image detail (vision): high | low | auto  (default high for IPA)
#   --detail high  or  --extra-json '{"detail":"high"}'

# Deprecated: LLM_OCR_PORT is ignored with a warning (base_url is the only endpoint knob).
# LLM_OCR_PORT=2113
